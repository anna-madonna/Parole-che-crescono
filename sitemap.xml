---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {% for page in site.pages %}
  {% unless page.url == "/sitemap.xml" or page.url == "/robots.txt" or page.url == "/feed.xml" %}
  {% if page.url and page.layout != nil %}
  <url>
    <loc>{{ page.url | replace:'index.html','' | prepend: site.url }}</loc>
    <lastmod>{% if page.last_modified_at %}{{ page.last_modified_at | date_to_xmlschema }}{% elsif page.date %}{{ page.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endif %}
  {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | prepend: site.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  {% for guide in site.guide %}
  <url>
    <loc>{{ guide.url | prepend: site.url }}</loc>
    <lastmod>{% if guide.date %}{{ guide.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
</urlset>
